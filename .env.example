# Bu dosyayı .env olarak kopyala ve kendi bilgilerinle doldur.
# .env asla git'e commit edilmemeli (.gitignore'da).

# --- FACEIT (Faz 1) ---
# Data API key: https://developers.faceit.com -> uygulama oluştur -> API Keys panelinden
# "server-side" key üret.
FACEIT_API_KEY=

# Downloads API token: AYRI bir onay süreci gerektirir (https://fce.gg/downloads-api-application,
# yanıt ~30 gün sürebilir). Bu token olmadan demo_url elde edilir ama otomatik indirilemez;
# demoyu maç odasından elle indirmen gerekir. Onaylanınca buraya ekle.
FACEIT_DOWNLOADS_API_TOKEN=

# Oyuncu: ikisinden birini doldur (nickname varsa otomatik player_id'ye çevrilir)
FACEIT_PLAYER_NICKNAME=
FACEIT_PLAYER_ID=
FACEIT_GAME_ID=cs2

# --- Steam (Faz 1 - deneysel, henüz implemente edilmedi) ---
STEAM_USERNAME=
STEAM_PASSWORD=
STEAM_SHARED_SECRET=

# --- Highlight tespiti (Faz 2) ---
CS2_TICKRATE=64
HIGHLIGHT_PRE_SECONDS=6.5
HIGHLIGHT_POST_SECONDS=2.5
DEFAULT_TOP_N=10
