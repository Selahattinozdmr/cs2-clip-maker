# Bu dosyayı .env olarak kopyala ve kendi bilgilerinle doldur.
# .env asla git'e commit edilmemeli (.gitignore'da).

# --- FACEIT (Faz 1) ---
# Data API key: https://developers.faceit.com -> uygulama oluştur -> API Keys panelinden
# "server-side" key üret.
FACEIT_API_KEY=

# Downloads API token: AYRI bir onay süreci gerektirir (https://fce.gg/downloads-api-application,
# yanıt ~30 gün sürebilir). Bu token olmadan demo_url elde edilir ama otomatik indirilemez;
# demoyu maç odasından elle indirmen gerekir. Onaylanınca buraya ekle.
FACEIT_DOWNLOADS_API_TOKEN=

# Oyuncu: ikisinden birini doldur (nickname varsa otomatik player_id'ye çevrilir)
FACEIT_PLAYER_NICKNAME=
FACEIT_PLAYER_ID=
FACEIT_GAME_ID=cs2

# --- Steam (Faz 1 - deneysel, henüz implemente edilmedi) ---
STEAM_USERNAME=
STEAM_PASSWORD=
STEAM_SHARED_SECRET=

# --- Highlight'ları kendi oyuncunla sınırlama (Faz 2) ---
# Doldurulmazsa TÜM oyuncuların (rakipler dahil) highlight'ları tespit edilir.
# Steamid64, isimden daha güvenilirdir (isim demo başına değişebilir).
# Steamid64'ünü bulmak için: kendi Steam profilin -> "..." -> Profil URL'sini Kopyala ->
# steamid.io adresine yapıştır (ya da FACEIT profilinde "Steam ID" alanına bak).
MY_STEAMID64=
MY_PLAYER_NAME=

# --- Highlight tespiti (Faz 2) ---
CS2_TICKRATE=64
HIGHLIGHT_PRE_SECONDS=6.5
HIGHLIGHT_POST_SECONDS=2.5
DEFAULT_TOP_N=10

# --- Klip render (Faz 3 - CS2 + OBS gerektirir) ---
# CS2'yi şu launch option'larla aç (Steam -> CS2 -> Özellikler -> Başlatma Seçenekleri):
#   -tools -netconport 2121 -insecure
# "-tools" için Steam'den "Counter-Strike 2 Workshop Tools" kurulu olmalı (netconport CS2'de
# bunsuz çalışmıyor). "-insecure" VAC'ı kapatır, sadece kendi demo izlemen için kullan.
CS2_NETCON_HOST=127.0.0.1
CS2_NETCON_PORT=2121
CS2_DEMO_LOAD_WAIT_SECONDS=5.0

# OBS: Tools -> WebSocket Server Settings -> Enable WebSocket server
OBS_WEBSOCKET_HOST=127.0.0.1
OBS_WEBSOCKET_PORT=4455
OBS_WEBSOCKET_PASSWORD=

# --- Paylaşım (Faz 5) ---
# Onay botu: @BotFather'dan bot oluştur, botla DM başlat, getUpdates ile chat_id'ni bul.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# TikTok: developers.tiktok.com'da app oluştur, Content Posting API ekle, video.publish
# scope'u iste, redirect URI = http://localhost:8721/callback. Sonra: python tiktok_auth.py
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Instagram: Business/Creator hesap + bağlı Facebook Page + instagram_content_publish
# izinli uzun ömürlü access token (Meta Graph API Explorer'dan alınabilir).
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_IG_USER_ID=

# YouTube: Google Cloud Console -> YouTube Data API v3 -> OAuth client (Desktop app tipi) ->
# indirilen JSON'u data/youtube_client_secret.json'a koy. İlk çalıştırmada tarayıcı açılır.
YOUTUBE_CLIENT_SECRETS_FILE=data/youtube_client_secret.json
YOUTUBE_TOKEN_FILE=data/youtube_token.json
