.env
__pycache__/
*.pyc
.venv/
venv/

# İndirilen/decompress edilen demolar ve üretilen çıktılar commit edilmesin
demos/*.dem
demos/*.dem.zst
demos/*.dem.gz
!demos/.gitkeep
output/*
!output/.gitkeep
logs/*
!logs/.gitkeep

# OAuth token'ları ve maç kayıtları gibi hassas/üretilen veriler (tiktok_token.json,
# youtube_token.json, youtube_client_secret.json, faceit_player.json, processed_matches.json)
data/*
!data/.gitkeep
